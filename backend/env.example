# Copy this file to .env and fill in real values. .env itself is gitignored.

# Must match docker-compose.yml's db credentials exactly.
DATABASE_URL=postgresql+psycopg://ssms_user:ssms_pass@localhost:5432/ssms_db

# Any long random string is fine for local dev, but BOTH collaborators
# should use the same value in their own .env so tokens/behaviour stay
# consistent while testing together.
JWT_SECRET_KEY=change-me-to-a-random-string

# Comma-separated list the frontend will run from. Used to replace the
# current allow_origins=["*"] wildcard in api/main.py.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
